# Copy this file to .env and fill in your API key(s)

# DeepSeek API Configuration (Default)
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Optional: Default OpenAI-compatible endpoint for Gemini
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen3.5:27b
